---
import { getBook, chapterHref, downloadHref } from '../../lib/book';
import { UI, ruCounterpart, fill } from '../../lib/i18n';
import Book from '../../layouts/Book.astro';

const ui = UI.en;
const { chapters, parts } = await getBook('en');
const alternate = ruCounterpart('/en/');
---

<Book title={ui.homeTitle} parts={parts} locale="en" alternate={alternate}>
  <section class="home">
    <p class="home__kicker">{fill(ui.homeKicker, { year: new Date().getFullYear() })}</p>
    <h1 class="home__title">{ui.homeH1}</h1>
    <p class="home__lede">
      {ui.homeLede}
    </p>

    <div class="progress">
      <span data-progress-total={chapters.length}>{fill(ui.progressTemplate, { done: 0, total: chapters.length })}</span>
      <div class="progress__bar"><div class="progress__fill" data-progress-fill></div></div>
      <span>{ui.chaptersRead}</span>
    </div>

    <p class="home__lede" style="display:flex; gap:0.8rem; margin-bottom:0;">
      <a href={downloadHref('adtech-ru.epub')} download>{ui.downloadEpub}</a>
      <a href={downloadHref('adtech-ru.pdf')} download>{ui.downloadPdf}</a>
    </p>

    {
      parts.map((p) => (
        <>
          <h2 class="toc-part">{p.label}</h2>
          <ul class="toc">
            {p.chapters.map((ch) => (
              <li class="toc__item">
                <div class="toc__row">
                  <label class="read-toggle" aria-label={fill(ui.markReadAria, { title: ch.data.title })}>
                    <input type="checkbox" data-read-toggle={ch.data.id} />
                  </label>
                  <span class="toc__num">{ch.data.chapter}</span>
                  <a class="toc__link" data-read-link={ch.data.id} href={chapterHref(ch, 'en')}>
                    {ch.data.title}
                  </a>
                  {ch.data.status !== 'final' && <span class="toc__status">{ch.data.status}</span>}
                </div>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>
</Book>
