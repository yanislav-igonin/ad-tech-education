---
import { render, type CollectionEntry } from 'astro:content';
import { getBook, chapterHref, navOf } from '../../../lib/book';
import { UI, ruCounterpart, fill } from '../../../lib/i18n';
import Book from '../../../layouts/Book.astro';

export async function getStaticPaths() {
  const { chapters } = await getBook('en');
  return chapters.map((chapter) => ({ params: { slug: chapter.data.slug }, props: { chapter } }));
}

type Props = { chapter: CollectionEntry<'chaptersEn'> };

const { chapter } = Astro.props;
const ui = UI.en;
const { chapters, parts } = await getBook('en');
const { prev, next } = navOf(chapters, chapter);
const { Content, headings } = await render(chapter);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const partLabel = parts.find((p) => p.part === chapter.data.part)?.label ?? chapter.data.part;
const byId = new Map(chapters.map((c) => [c.data.id, c]));
const alternate = ruCounterpart(Astro.url.pathname);
---

<Book title={`${chapter.data.title} — AdTech Education`} parts={parts} current={chapter} locale="en" alternate={alternate}>
  <article class="chapter">
    <p class="chapter__crumb">{fill(ui.chapterCrumb, { part: partLabel, chapter: chapter.data.chapter })}</p>
    <div class="chapter__head">
      <div>
        <h1 class="chapter__title">{chapter.data.title}</h1>
        <p class="chapter__meta">
          {fill(ui.statusLabel, { status: chapter.data.status })}
          {
            chapter.data.prerequisites.length > 0 && (
              <span>
                {' '}· {ui.prerequisites}{' '}
                {chapter.data.prerequisites.map((pid, i) => {
                  const pre = byId.get(pid);
                  return (
                    <>
                      {i > 0 && ', '}
                      {pre ? <a href={chapterHref(pre, 'en')}>{pre.data.title}</a> : pid}
                    </>
                  );
                })}
              </span>
            )
          }
        </p>
      </div>
      <label class="read-toggle">
        <input type="checkbox" data-read-toggle={chapter.data.id} />
        <span>{ui.readLabel}</span>
      </label>
    </div>

    {
      toc.length > 0 && (
        <nav class="tocbox" aria-label={ui.chapterTocAria}>
          <p class="tocbox__title">{ui.chapterTocTitle}</p>
          <ul>
            {toc.map((h) => (
              <li style={`margin-left:${(h.depth - 2) * 1.2}rem`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <nav class="pager">
      {
        prev && (
          <a href={chapterHref(prev, 'en')}>
            <small>{fill(ui.pagerPrev, { n: prev.data.chapter })}</small>
            <b>{prev.data.title}</b>
          </a>
        )
      }
      {
        next && (
          <a class="pager--next" href={chapterHref(next, 'en')}>
            <small>{fill(ui.pagerNext, { n: next.data.chapter })}</small>
            <b>{next.data.title}</b>
          </a>
        )
      }
    </nav>
  </article>
</Book>
