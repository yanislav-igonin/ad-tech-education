---
import { getBook } from '../../lib/book';
import { UI, ruCounterpart } from '../../lib/i18n';
import Book from '../../layouts/Book.astro';
import { glossaryTerms, glossaryTermHtml } from '../../lib/glossary';

const ui = UI.en;
const { parts } = await getBook('en');
const terms = await Promise.all(
  glossaryTerms('en').map(async (term) => ({ ...term, html: await glossaryTermHtml(term) })),
);
const alternate = ruCounterpart('/en/glossary/');
---

<Book title={ui.glossaryDocTitle} parts={parts} locale="en" alternate={alternate}>
  <article class="chapter">
    <p class="chapter__crumb">{ui.reference}</p>
    <div class="chapter__head">
      <h1 class="chapter__title">{ui.glossary}</h1>
    </div>
    <p class="chapter__meta">
      {ui.glossaryMeta}
    </p>
    <div class="prose">
      {
        terms.map((term) => (
          <section class="glossary-term" id={`g-${term.id}`}>
            <h3>{term.title}</h3>
            <Fragment set:html={term.html} />
          </section>
        ))
      }
    </div>
  </article>
</Book>
