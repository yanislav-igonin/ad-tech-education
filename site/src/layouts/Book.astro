---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { href, downloadHref, type Chapter } from '../lib/book';

interface Props {
  title: string;
  parts: { part: string; label: string; chapters: Chapter[] }[];
  current?: Chapter | null;
}

const { title, parts, current = null } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,600&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400&family=Golos+Text:wght@400..700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <aside class="spine">
      <a class="spine__brand" href={BASE}>
        <span>AdTech Education</span>
        <b>Книга по рекламным технологиям</b>
      </a>
      {
        parts.map((p) => (
          <>
            <p class="spine__part">{p.label}</p>
            <ul class="spine__list">
              {p.chapters.map((ch) => (
                <li>
                  <a
                    class="spine__link"
                    href={href(ch)}
                    aria-current={current?.data.id === ch.data.id ? 'page' : undefined}
                  >
                    <span class="spine__num">{ch.data.chapter}</span>
                    {ch.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p class="spine__part">Справочник</p>
      <ul class="spine__list">
        <li>
          <a class="spine__link" href={`${BASE}glossary/`}>
            <span class="spine__num">*</span>
            Глоссарий
          </a>
        </li>
      </ul>
      <div class="spine__dl">
        <a href={downloadHref('adtech-ru.epub')} download>EPUB</a>
        <a href={downloadHref('adtech-ru.pdf')} download>PDF</a>
      </div>
    </aside>

    <main class="page">
      <slot />
    </main>

    <script>
      const KEY = 'adtech-read';

      type ReadMap = Record<string, boolean>;

      function load(): ReadMap {
        try {
          return JSON.parse(localStorage.getItem(KEY) ?? '{}') as ReadMap;
        } catch {
          return {};
        }
      }

      function save(map: ReadMap) {
        localStorage.setItem(KEY, JSON.stringify(map));
      }

      function paint(map: ReadMap) {
        const done = Object.values(map).filter(Boolean).length;
        document.querySelectorAll<HTMLElement>('[data-read-toggle]').forEach((el) => {
          const input = el as HTMLInputElement;
          if (!(input instanceof HTMLInputElement)) return;
          input.checked = Boolean(map[input.dataset.readToggle ?? '']);
        });
        document.querySelectorAll<HTMLElement>('[data-read-link]').forEach((el) => {
          el.classList.toggle('is-done', Boolean(map[el.dataset.readLink ?? '']));
        });
        document.querySelectorAll<HTMLElement>('[data-progress-total]').forEach((el) => {
          const total = Number(el.dataset.progressTotal);
          el.textContent = `${done} из ${total}`;
          const fill = el.parentElement?.querySelector<HTMLElement>('[data-progress-fill]');
          if (fill) fill.style.width = total ? `${(done / total) * 100}%` : '0';
        });
      }

      function init() {
        document.querySelectorAll<HTMLInputElement>('[data-read-toggle]').forEach((input) => {
          if (input.dataset.readBound) return;
          input.dataset.readBound = '1';
          input.addEventListener('change', () => {
            const map = load();
            const id = input.dataset.readToggle ?? '';
            if (input.checked) map[id] = true;
            else delete map[id];
            save(map);

            paint(map);
          });
        });
        paint(load());
      }

      document.addEventListener('astro:page-load', init);
      document.addEventListener('DOMContentLoaded', init);
    </script>

    <script>
      // Тултип сносок: hover/focus на циферке показывает определение,
      // контент берём из секции сносок внизу страницы. На тач-устройствах
      // определение открывается по тапу.
      let tip: HTMLElement | null = null;

      function initGlosstip() {
        const w = window as unknown as { __glosstipBound?: boolean };

        // ClientRouter заменяет <body> при клиентской навигации — попап
        // выпадает из DOM. Переподвешиваем тот же узел на каждой странице.
        if (!tip) {
          tip = document.createElement('div');
          tip.id = 'glosstip';
          tip.className = 'glosstip';
        }
        if (!tip.isConnected) document.body.append(tip);
        tip.classList.remove('is-open');

        if (w.__glosstipBound) return;
        w.__glosstipBound = true;

        const BASE = import.meta.env.BASE_URL.endsWith('/')
          ? import.meta.env.BASE_URL
          : `${import.meta.env.BASE_URL}/`;

        const hide = () => tip?.classList.remove('is-open');

        const show = (a: HTMLAnchorElement) => {
          if (!tip) return;
          const href = a.getAttribute('href') ?? '';
          if (!href.startsWith('#')) return;
          const src = document.getElementById(href.slice(1));
          if (!src) return;
          const clone = src.cloneNode(true) as HTMLElement;
          clone.querySelectorAll('.data-footnote-backref').forEach((el) => el.remove());
          tip.replaceChildren(...clone.childNodes);
          const termId = href.match(/^#user-content-fn-g-([\w-]+)$/)?.[1];
          if (termId) {
            const more = document.createElement('a');
            more.className = 'glosstip__more';
            more.href = `${BASE}glossary/#g-${termId}`;
            more.textContent = 'Глоссарий →';
            tip.append(more);
          }
          const r = a.getBoundingClientRect();
          tip.style.top = `${Math.round(r.bottom + window.scrollY + 8)}px`;
          tip.classList.add('is-open');
          const max = document.documentElement.clientWidth - 16;
          const left = Math.min(Math.max(12, r.left + window.scrollX - 24), Math.max(12, max - tip.offsetWidth));
          tip.style.left = `${Math.round(left)}px`;
          tip.dataset.for = a.id ?? '';
        };

        document.addEventListener('mouseover', (e) => {
          const a = (e.target as HTMLElement).closest?.('a[data-footnote-ref]');
          if (a) show(a as HTMLAnchorElement);
          else if (!(e.target as HTMLElement).closest?.('#glosstip')) hide();
        });
        document.addEventListener('mouseout', (e) => {
          if ((e.target as HTMLElement).closest?.('a[data-footnote-ref]')) hide();
        });
        document.addEventListener('focusin', (e) => {
          const a = (e.target as HTMLElement).closest?.('a[data-footnote-ref]');
          if (a) show(a as HTMLAnchorElement);
        });
        document.addEventListener('focusout', hide);
        window.addEventListener('scroll', hide, { passive: true });
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest?.('a[data-footnote-ref]') as HTMLAnchorElement | null;
          if (a && window.matchMedia('(hover: none)').matches) {
            e.preventDefault();
            if (tip && tip.dataset.for === a.id && tip.classList.contains('is-open')) hide();
            else show(a);
          } else if (!a) {
            hide();
          }
        });
      }

      document.addEventListener('astro:page-load', initGlosstip);
      document.addEventListener('DOMContentLoaded', initGlosstip);
    </script>
  </body>
</html>
